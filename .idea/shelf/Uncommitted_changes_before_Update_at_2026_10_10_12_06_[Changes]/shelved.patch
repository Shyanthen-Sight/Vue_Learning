+                    names: "",
+                    citys: "",
+                    proList: [
+                        {name: '鸭梨',city: '北京' },
+                        {name: '花牛苹果', city: '甘肃' },
+                        {name: '松茸',city: '云南'}
+                    ]
+                }
+            },
+            methods: {
+                add() {
+                    this.proList.unshift({
