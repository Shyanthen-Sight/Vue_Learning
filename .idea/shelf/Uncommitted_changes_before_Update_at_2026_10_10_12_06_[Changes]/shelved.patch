+<!DOCTYPE html>
+<html lang='en'>
+
+<head>
+    <meta charset='UTF-8'>
+    <title>商品列表页面</title>
+    <style>
+        * {
+            /*清除默认样式*/
+            margin: 0;
+            padding: 0;
+        }
+
+        li {
+            list-style: none;
