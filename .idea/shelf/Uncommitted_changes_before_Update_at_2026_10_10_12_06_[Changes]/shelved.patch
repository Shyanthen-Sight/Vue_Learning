+    <div class="shop-list">
+        <!-- 商品订单tab -->
+        <div class="shop-tab">
+            <div>商品信息</div>
+            <span class="check-tab" id="0">已完成订单</span>
+            <span id="1">未完成订单</span>
+            <span id="2">全部订单</span>
