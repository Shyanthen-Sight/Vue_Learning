+                    password: "123456",
+                    pwdFlag: false,
+                    userFlag: false,
+                    isDisabled: true,
+                }
+            },
+            methods: {
+                // 阻止表单的默认提交事件
+                handleSubmit() {
+                    console.log("阻止form表单的默认事件");
+                },
+                // 编辑账户信息
+                editUser() {
+                    this.userFlag = true;
+                },
+                // 完成账号修改触发的事件
+                overUser() {
+                    console.log("账户修改完成");
+                    this.userFlag = false;
+                },
+                // 控制密码编辑按钮与密码文本框的交叉显示
+                editPwd() {
+                    this.pwdFlag = true;
+                },
+                // 密码修改完成触发本方法
+                overPwd() {
+                    console.log("密码修改完成");
+                    this.pwdFlag = false;
+                },
+                  // 控制协议的选中与否
+                  handleDisabled(event) {
+                    if (event.target.checked==true) {
+                        this.isDisabled = false;
+                    } else {
+                        this.isDisabled = true;
+                    }
+                },
+                //提交信息
+                submit(){
+                    alert("用户信息存储成功");
+                }
+            },
+            //计算属性
+            computed: {
+                passwordFilter() {
+                    let len = this.password.length;
+                    return this.password.replace(this.password.substring(2, len - 2), "***")
+                }
+            }
+        }).mount('#app')
+    </script>
+</body>
