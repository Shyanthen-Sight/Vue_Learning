+                    username: '',
+                    password: '',
+                    sex: '',
+                    agreement: '',
+                    choseCity: '',
+                },
+                cityList: ["北京","河北", "山西", "黑龙江", "吉林","等"],
+                sexList: ['男', '女']
+            }
+        },
+        methods: {
+            // 信息提交方法
+            submitPost() {
+                alert(JSON.stringify(this.user));
+            }
+        }
+    }).mount('#app')
+</script>
+</body>
