+<script>
+    const {ref,watchEffect} = Vue;
+    const vm = Vue.createApp({
+        setup() {
+            //响应式的商品信息数组
+            const minute = ref(1);
+            const second=ref(0);
+            watchEffect(
+                ()=>{second.value=minute.value*60;}
+                //该侦听器会立即执行
+                //在页面初次渲染时将second转换为60
+            )
+            return{minute,second}
