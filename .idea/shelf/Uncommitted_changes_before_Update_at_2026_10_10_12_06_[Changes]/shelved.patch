+    ul {
+        margin: 0 20px;
+        padding: 0 0;
+    }
+
+    /* 列表项 */
+    li {
+        list-style: none;
+        height: 50px;
+        line-height: 80px;
+        font-weight: 600;
+        font-size: 20px;
+        font-family: 'Times New Roman', Times, serif;
+        border-bottom: 1px solid gainsboro;
+        margin-bottom: 20px;
+        line-height: 50px;
+        padding: 0 5px;
+        box-sizing: border-box;
+    }
+
+    /* 单行文本框样式 */
+    input[type="text"],
+    input[type="password"] {
+        width: 80%;
+        height: 30px;
+        border-radius: 4px;
+        border: 1px solid #c8cccf;
+        color: #6a6f77;
+        padding-top: 5px;
+    }
+
+    /* 确认信息样式 */
+    .sure {
+        color: #6a6f77;
+        font-size: 16px;
+    }
+
+    /* 提交样式 */
+    button {
+        width: 100%;
+        height: 100%;
+        color: #fff;
+        background: #e2231a;
+        border: 0;
+        text-align: center;
+    }
+</style>
+
+<body>
+    <div id='app' v-cloak>
+        <div class="accountBox">
+            <h1>{{msg}}</h1>
+            <form  @submit.prevent="handleSubmit">
+                <ul>
+                    <li>
+                        <label for="username">账户：</label>
+                        <span v-show="!userFlag" @click.once="editUser">{{username}}</span>
+                        <input v-show="userFlag" v-model="username" @keypress.enter="overUser" type="text"
+                            id="username">
+                    </li>
+                    <li>
+                        <label for="password">密码：</label>
+                        <span v-show="!pwdFlag" @click="editPwd">{{passwordFilter}}</span>
+                        <input v-show="pwdFlag" v-model="password" @keypress.enter="overPwd" type="text" id="password">
+                    </li>
+                    <li>
+                        <input type="checkbox" name="agreement" id="agreement" @click="handleDisabled">
